{
  "name": "lightroom-controller",
  "version": "1.3.0",
  "description": "Control Adobe Lightroom using HTTP requests",
  "keywords": [
    "lightroom",
    "creative-cloud",
    "controller",
    "websocket",
    "plugin",
    "adobe"
  ],
  "homepage": "https://github.com/electerious/lightroom-controller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electerious/lightroom-controller.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "lightroom-controller": "bin/index.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "eslint": "eslint \"**/*.js\"",
    "format": "npm run eslint -- --fix && npm run prettier -- --write",
    "lint": "npm run eslint && npm run prettier -- --check",
    "prettier": "prettier --ignore-path .gitignore \"**/*.{js,json,md,yml}\"",
    "start": "./bin/index.js",
    "test": "npm run lint && node --test"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "prompts": "^2.4.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electerious/eslint-config": "^6.0.0",
    "@electerious/prettier-config": "^5.0.0",
    "eslint": "^10.8.1",
    "get-port": "^7.2.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "authors": [
    "Tobias Reich <tobias@electerious.com>"
  ]
}
